# Template for the service environment: cp .env.example .env, then fill in .env.
# This file is published with the repository: NEVER put a real key here.
# Without .env the service runs with the defaults named below.


# Network

# 127.0.0.1 = this machine only; 0.0.0.0 = every attached network (right in a container).
# Default: 127.0.0.1 on a workstation, 0.0.0.0 in the container
COMPLIANCE_HELPER_HOST=127.0.0.1

# Default: 8000
COMPLIANCE_HELPER_PORT=8000

# Comma-separated origins allowed to call the API. No wildcard: a foreign site must not ask legal
# questions on the user's behalf.
# Default: http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
COMPLIANCE_HELPER_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Requests per minute and client address, only for routes under /api/. Default: 30
COMPLIANCE_HELPER_REQUESTS_PER_MINUTE=30

# Largest request body the service reads; larger ones get HTTP 413. Default: 131072 (128 KiB)
COMPLIANCE_HELPER_MAX_BODY_BYTES=131072

# Comma-separated addresses of reverse proxies whose X-Forwarded-For header the rate limit trusts.
# Default: empty, the header is ignored and every connection counts by its own address.
COMPLIANCE_HELPER_TRUSTED_PROXIES=


# Search model

# A stored index always loads the model named in its own metadata (BAAI/bge-m3 for the shipped
# indexes), because vectors of different models are not comparable. With the "search" extra
# installed and HF_HUB_OFFLINE not 1, that loads bge-m3 from the cache or downloads it once
# (about 2.3 GB); without it, search falls back. This setting chooses the model only for an index
# built in memory, and hashing-fallback also skips the stored index.
#   BAAI/bge-m3        good multilingual model, about 2.3 GB
#   hashing-fallback   no model: compares words, not meaning; starts instantly, finds much worse
# Default if empty: the model of the stored index; hashing-fallback for an index built in memory.
COMPLIANCE_HELPER_EMBEDDING=BAAI/bge-m3

# The cross-encoder BAAI/bge-reranker-v2-m3 serves two uses.
#   1       also reorders the search hits: measurably better order, but about 100 s per search
#           without a GPU (under 1 s with one)
#   empty   search order as it is; purpose matching on (it scores short sentence pairs, fast enough)
#   0       both off; classification relies on the rule keywords alone and /health says so
# Default: empty (the small container image sets 0, because it ships no cross-encoder)
COMPLIANCE_HELPER_RERANK=


# Answer composition
#
# The classification ALWAYS comes from the rule files; an LLM only phrases the text around it and
# cannot change the result.

#   auto        whatever is reachable: Claude, then GPT
#   anthropic   Claude
#   openai      GPT
#   none        no LLM, answer from the rule set only
# Default: auto
COMPLIANCE_HELPER_MODEL=auto

# Real keys belong only in your own .env. Without a key, leave empty and set
# COMPLIANCE_HELPER_MODEL=none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Seconds a language model may take per call (one retry); then the answer comes from the rule set
# with a note. Default: 30
COMPLIANCE_HELPER_LLM_TIMEOUT=30


# Language

# Language of the command line, the start scripts and the packaged app, and the service's default
# when neither ?lang=, the lang cookie nor the browser names German or English. de or en.
# Default: de; the start scripts and the packaged app follow the system language instead
COMPLIANCE_HELPER_LANG=de


# Storage

# Model cache. In the full container image /opt/models, where both models are already baked in.
# Default on a workstation: ~/.cache/huggingface
HF_HOME=

# 1 forbids model downloads, so a missing model fails fast instead of loading silently
# (set in the container).
HF_HUB_OFFLINE=0


# Debugging
#
# NEVER set in production; the service warns at start because debug mode can leak internals.
# DEBUG=

# Whether the service may build the search index at start if the stored files are missing. With
# bge-m3 that takes hours without a GPU, so by default it uses the fallback and says so. Build the
# index once instead:  compliance-helper build-index --language de  (and --language en)
# 1 = build and wait, 0 = do not build. Default: 0
COMPLIANCE_HELPER_BUILD_INDEX=0
