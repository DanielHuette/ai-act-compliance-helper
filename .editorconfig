# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Same line length as ruff in pyproject.toml
[*.py]
max_line_length = 100

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.{yaml,yml}]
indent_size = 2

[*.{json,jsonl}]
indent_size = 2

[*.cff]
indent_size = 2

[*.toml]
indent_size = 4

[*.xml]
indent_size = 4

# Two trailing spaces are a line break in Markdown
[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{gradle,properties}]
indent_size = 4

# Generated by Gradle
[gradlew*]
indent_style = unset
indent_size = unset

[Makefile]
indent_style = tab

[Dockerfile]
indent_size = 4

[*.sh]
indent_size = 2

[*.ps1]
end_of_line = crlf
indent_size = 4
